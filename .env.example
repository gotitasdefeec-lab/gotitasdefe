# URL base del API (mock json-server por defecto)
# Cambia si tu backend corre en otra URL o puerto.
## Admin app API base URL
# Local Nest backend default port is 4001 (JSON Server mock may use 4000)
REACT_APP_API_URL=http://localhost:4001

# Optionally point to your public tunnel (must be HTTPS to avoid mixed content):
# REACT_APP_API_URL=https://your-backend-subdomain.ngrok-free.dev

# Backend CORS origins override (comma-separated). Otherwise defaults allow localhost and any ngrok subdomain.
# CORS_ORIGINS=https://your-admin-subdomain.ngrok.app,https://another-origin.example

# When true, do not fallback to mock auth if /auth/login fails; surface the error
# REACT_APP_STRICT_BACKEND=true

# Credenciales admin para el fallback local del Login (opcional)
# Si no se establecen, el Login intentará el endpoint /admin del json-server
# con las credenciales de mock incluidas en mock/db.json
# REACT_APP_ADMIN_EMAIL=admin@tienda.com
# REACT_APP_ADMIN_PASSWORD=admin123

# PayPal Configuration
# Get these from https://developer.paypal.com/dashboard/applications/sandbox
PAYPAL_CLIENT_ID=your-paypal-client-id
PAYPAL_CLIENT_SECRET=your-paypal-client-secret
# Mode: 'sandbox' for testing, 'live' for production
PAYPAL_MODE=sandbox
# ============================================
# REVALIDACIÓN BAJO DEMANDA (On-Demand ISR)
# ============================================
# URL del storefront (Next.js) donde se despliega la tienda
# Ejemplo: https://www.gotasdefe.com o https://your-store.vercel.app
REACT_APP_STOREFRONT_URL=https://www.gotasdefe.com

# Token secreto para revalidar la caché del storefront
# DEBE coincidir con REVALIDATION_TOKEN en el .env del storefront
# Genera uno aleatorio seguro: openssl rand -base64 32
REACT_APP_REVALIDATION_TOKEN=your-secret-revalidation-token-here